{
  "name": "kuiper",
  "private": true,
  "description": "Kuiper — a hybrid Solana DEX aggregator (own router + Jupiter fallback)",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "dev:api": "pnpm --filter @kuiper/api dev",
    "dev:web": "pnpm --filter @kuiper/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @kuiper/core test",
    "typecheck": "pnpm -r typecheck",
    "verify:pool": "pnpm --filter @kuiper/api verify:pool",
    "discover:cpmm": "pnpm --filter @kuiper/api discover:cpmm",
    "fee-accounts": "pnpm --filter @kuiper/api fee-accounts"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
