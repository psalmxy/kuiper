# --- API (apps/api) ---
# A paid/private RPC is strongly recommended (Helius, Triton, QuickNode). Public RPC will rate-limit the pool refresh loop.
RPC_URL=https://api.mainnet-beta.solana.com
# Free key from https://portal.jup.ag — used for the Jupiter fallback route
JUP_API_KEY=
# Your fee wallet (owner). Fees are taken in the INPUT token and sent to this wallet's ATA.
FEE_WALLET=
PLATFORM_FEE_BPS=20
POOL_REFRESH_MS=2000
# Set after deploying programs/kuiper-router — enables multi-hop Kuiper routes
KUIPER_ROUTER_PROGRAM_ID=
PORT=8787

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
